{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/pro",
      "destination": "/pro/planes/",
      "permanent": false
    },
    {
      "source": "/pro/",
      "destination": "/pro/planes/",
      "permanent": false
    },
    {
      "source": "/pro/en",
      "destination": "/pro/planes/en/",
      "permanent": false
    },
    {
      "source": "/pro/en/",
      "destination": "/pro/planes/en/",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.drawsports.app"
        }
      ],
      "destination": "https://drawsports.app/:path*",
      "permanent": true
    },
    {
      "source": "/zh",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/zh/:path*",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ja",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ja/:path*",
      "destination": "/",
      "permanent": true
    }
  ],
  "buildCommand": "npm run build",
  "outputDirectory": ".",
  "headers": [
    {
      "source": "/imagenes/(.*\\.(webp|png|jpg|jpeg|svg))",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
